{
  "name": "cognito-manual-demo",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.tsx",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/migrate-cli.ts",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1158.0",
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
